#!/usr/bin/python3

import datetime
import json
import socket
import sys
import time

from pymodbus.client import ModbusTcpClient

import goeapi


# XXX make configurable
GO_E = "192.168.178.40"
MARSTEK = "192.168.178.149"

DEFAULT_SLEEP = 6 * 60
ERROR_SLEEP = 6


class ShellyMonitor:
    def __init__(self, ip, port):
        self.ip = ip
        self.port = port

    @property
    def current_power(self):
        payload = {
            "id": 1,
            "src": "python_script",
            "method": "EM1.GetStatus",
            "params": {"id": 0}
        }
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.settimeout(5.0)

        try:
            message = json.dumps(payload).encode('utf-8')
            print(f"Sending request to {self.ip}:{self.port}...")
            sock.sendto(message, (self.ip, self.port))
            data, addr = sock.recvfrom(4096)
            res = json.loads(data.decode('utf-8'))
            return res["result"]["act_power"]
        except socket.timeout:
            print("Error: Request timed out. Ensure UDP is enabled on the Shelly.")
        except Exception as e:
            print(f"An error occurred: {e}")
        finally:
            sock.close()
        return 0


class MarstekMonitor:
    def __init__(self, ip):
        self.ip = ip

    @property
    def ac_power(self):
        """Return ac-power in watts from register 30006 (int16)."""
        from pymodbus.constants import Endian
        from pymodbus.payload import BinaryPayloadDecoder
        client = ModbusTcpClient(host=self.ip)
        try:
            client.connect()
            reg = client.read_holding_registers(30006)
            decoder = BinaryPayloadDecoder.fromRegisters(reg.registers, byteorder=Endian.BIG)
            return decoder.decode_16bit_int()
        finally:
            client.close()


class EloaderController:
    def __init__(self):
        self.mon = ShellyMonitor("192.168.178.30", port=2222)
        self.marstek = MarstekMonitor(MARSTEK)
        self.goe = goeapi.GoeAPI(GO_E)
        self.last_connect = 0.0
        self.current_ampere = self.goe.ampere

    def loop(self):
        while True:
            try:
                sleeptime = self.tick()
            except OSError as e:
                print(f"network error {e}")
                sleeptime = DEFAULT_SLEEP
            # wait a bit
            time.sleep(sleeptime)

    def log(self, *args):
        print(*args, flush=True)

    def now(self):
        return datetime.datetime.now()

    def manual_overriden(self):
        return self.goe.phases != 1

    def tick(self):
        if self.manual_overriden():
            self.log(
                f"ampere or phases got manually overriden got {self.goe.ampere}/{self.goe.phases} "
                "sleeping until it goes back to 1 phase "
            )
            return DEFAULT_SLEEP

        current_power_charger = self.goe.power / 1000.0
        available_power = (-self.mon.current_power / 1000.0)
        # add the charger to the available (sun) power
        available_power += current_power_charger
        # normalize available power by removing the marstek contribution:
        # - when charging (ac_power < 0): subtracting negative adds it
        #   back, i.e. that power is available for the car instead
        # - when discharging (ac_power > 0): subtracting positive removes
        #   the battery power that inflates the shelly grid reading
        # this gives us the true solar surplus (solar - house)
        marstek_power = self.marstek.ac_power
        available_power -= marstek_power / 1000.0
        self.last_connect = time.time()
        self.log(
            f"available: {available_power:.2f} kW, charger: {current_power_charger} kW, "
            f"marstek: {marstek_power} W ({marstek_power / 1000.0:.2f} kW)"
        )
        if available_power < (230 * 6 / 1000.0):
            self.log("not enough power, forcing pause")
            self.goe.force_pause = True
            return DEFAULT_SLEEP
        for amp in [16, 14, 12, 10, 6]:
            pw = 230 * amp / 1000.0
            if pw < available_power:
                needs_switching = self.current_ampere != amp
                if needs_switching:
                    self.goe.ampere = amp
                    self.current_ampere = amp
                if self.goe.force_pause:
                    self.log("enough power, un-pause")
                    self.goe.force_pause = False
                self.log(f"switched: {needs_switching}, amp: {amp}, kW: {pw}")
                return DEFAULT_SLEEP
        self.log(f"internal error: should never be reached {available_power!r}")
        return DEFAULT_SLEEP


def main():
    if len(sys.argv) > 1:
        global DEFAULT_SLEEP
        DEFAULT_SLEEP = int(sys.argv[1])
    el = EloaderController()
    el.loop()


if __name__ == "__main__":
    main()
